  <text x="300" y="402" font-family="system-ui, -apple-system, sans-serif" font-weight="700" font-size="12" fill="#e8f3ee" text-anchor="middle" letter-spacing="1.5">PERSONAL CARE</text>
  <text x="300" y="445" font-family="system-ui, -apple-system, sans-serif" font-weight="800" font-size="22" fill="#081c15" text-anchor="middle">Natural Hand Wash</text>
